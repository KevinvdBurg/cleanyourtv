<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="310dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp"
    android:background="@drawable/shape_editor_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/shape_editor_title" android:textSize="22sp"
        android:textColor="#FFFFFFFF" android:fontFamily="@string/font_light" />
    <TextView android:id="@+id/shapeAppName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="14sp" android:textColor="#BFFFFFFF" android:fontFamily="@string/font_regular" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
        android:text="@string/shape_editor_help" android:textSize="12sp"
        android:textColor="#99FFFFFF" android:fontFamily="@string/font_regular" />
    <TextView android:id="@+id/shapeSize" style="@style/ShapeControl"
        android:nextFocusUp="@id/shapeSize" android:nextFocusDown="@id/shapeIntensity" />
    <TextView android:id="@+id/shapeIntensity" style="@style/ShapeControl"
        android:nextFocusUp="@id/shapeSize" android:nextFocusDown="@id/shapeReset" />
    <TextView android:id="@+id/shapeReset" style="@style/ShapeControl" android:text="@string/shape_reset"
        android:nextFocusUp="@id/shapeIntensity" android:nextFocusDown="@id/shapeSave" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/shapeSave" style="@style/ShapeControl" android:text="@string/shape_save"
            android:layout_width="0dp" android:layout_weight="1" android:gravity="center"
            android:layout_marginEnd="8dp" android:nextFocusLeft="@id/shapeSave"
            android:nextFocusRight="@id/shapeCancel" android:nextFocusUp="@id/shapeReset"
            android:nextFocusDown="@id/shapeAppInfo" />
        <TextView android:id="@+id/shapeCancel" style="@style/ShapeControl" android:text="@android:string/cancel"
            android:layout_width="0dp" android:layout_weight="1" android:gravity="center"
            android:nextFocusRight="@id/shapeCancel" android:nextFocusLeft="@id/shapeSave"
            android:nextFocusUp="@id/shapeReset" android:nextFocusDown="@id/shapeAppInfo" />
    </LinearLayout>
    <TextView android:id="@+id/shapeAppInfo" style="@style/ShapeControl" android:text="@string/shape_app_info"
        android:nextFocusUp="@id/shapeSave" android:nextFocusDown="@id/shapeAppInfo" />
</LinearLayout>
